{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDocumentBucketUpload",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::logistics-app-prod-documents/*"
    },
    {
      "Sid": "AllowDocumentBucketList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::logistics-app-prod-documents"
    }
  ]
}
